#version 460
#extension GL_EXT_buffer_reference : require

// values[i] = i * i, written through a buffer device address.
layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Values {
    uint value[];
};

layout(push_constant) uniform PushConstants {
    Values values;
    uint count;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) {
        pc.values.value[i] = i * i;
    }
}
